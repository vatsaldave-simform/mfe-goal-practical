# Required environment variables for apps/backend
# Copy this file to .env and fill in the values.

# Neon Postgres connection string — get yours at https://neon.tech (free tier available)
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://<user>:<password>@ep-xxx-yyy.us-east-2.aws.neon.tech/neondb?sslmode=require"
